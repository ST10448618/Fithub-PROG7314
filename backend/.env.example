# Copy to .env for local use. Never commit the real values.
PORT=8080
NODE_ENV=development

# Base64 of the Firebase service-account JSON. Generate with:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
#   bash:       base64 -w0 serviceAccount.json
# Paste the resulting single-line string below (no line breaks).
FIREBASE_SERVICE_ACCOUNT_B64=

# Optional tuning (defaults shown)
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=102400